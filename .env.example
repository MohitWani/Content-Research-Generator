APP_NAME= "python-fast-api-seed"
ENV_NAME= "local"
APP_VERSION= "0.0.0"
APP_HOST= "127.0.0.1"
APP_PORT= 8000

# Logging Configuration
LOG_LEVEL= "INFO"
LOG_PATH_PREFIX= "logs"
LOG_ROTATION= "10 MB"
LOG_RETENTION= "7 days"
LOG_COMPRESSION_TYPE= "zip"

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/some_db"

# Module enable
MODULE_NAMES=health,user,auth,research,paper,content,social,branding,pipelines

# DB Migration
ENABLE_DB_MIGRATIONS= False

# Rate Limiter (JSON string for endpoint-specific limits, eg. max 10 requests per 60 seconds where request count is "counts" and timelimit is "time(sec)")
RATE_LIMIT_CONFIG= '{"global": {"counts": 10, "time": 60}}'

# List of public endpoints (Without Auth)
PUBLIC_ENDPOINTS= '[{"endpoint":"/docs","method":"GET"},{"endpoint":"/redoc","method":"GET"},{"endpoint":"/openapi.json","method":"GET"},{"endpoint":"/api/v1/user","method":"POST"},{"endpoint":"/api/v1/auth/login","method":"POST"},{"endpoint":"/api/v1/auth/refresh","method":"POST"},{"endpoint":"/.well-known/jwks.json","method":"GET"},{"endpoint":"/api/health","method":"GET"}]'

# Public and Private Keys
PRIVATE_KEY= "your_private_key"
PUBLIC_KEY= "your_public_key"

# Cache Configuration
CACHE_PROVIDER= "aiocache"
CACHE_TTL_SECONDS= 3600
